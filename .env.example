# Etherscan API Key (Required)
# Get from https://etherscan.io/apis
ETHERSCAN_API_KEY=YourApiKeyToken

# Etherscan Tier: 'free' or 'paid'
# Free tier only supports: Ethereum(1), Polygon(137), Arbitrum(42161), Linea(59144), Blast(81457), etc.
# Paid tier supports all EVM chains (BSC, Base, Optimism, Avalanche, etc.)
ETHERSCAN_TIER=free

# OpenRouter API Key (Required if AI_ENABLED=true)
# Get from https://openrouter.ai/settings
OPENROUTER_API_KEY=sk-or-...

# AI Configuration
AI_ENABLED=false
AI_MODEL=openai/gpt-4o-mini
AI_TEMPERATURE=0.3

# Pipeline Configuration
CACHE_ENABLED=true
CACHE_TTL_SECONDS=604800  # 7 days
RATE_LIMIT_RPS=5

# Concurrency
FETCH_PARALLEL=5
AI_PARALLEL=1
AI_DELAY_MS=1000

# Paths
INPUT_DIR=./data/input/DeFiHackLabs/src/test
OUTPUT_DIR=./data/output
CACHE_DIR=./data/cache
IDEMPOTENCY_DIR=./data/cache/idempotency

# Output
CHUNK_SIZE=100
IDEMPOTENCY_STRATEGY=skip

# Testing
TEST_LIMIT=0  # Set to a number (e.g., 5) to limit processing
