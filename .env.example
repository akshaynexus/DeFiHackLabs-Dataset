# Etherscan
ETHERSCAN_API_KEY=YourApiKeyToken
ETHERSCAN_TIER=free

# AI Configuration
# Provider auto-detected from model prefix (crof/, google/, openrouter/)
AI_ENABLED=false
AI_TEMPERATURE=0.8

# Set all API keys - pipeline uses the one matching provider
OPENROUTER_API_KEY=
CROF_API_KEY=
GEMINI_API_KEY=

# Separate models for extraction (cheap/fast) and analysis (detailed)
AI_EXTRACTION_MODEL=openrouter/gpt-4o-mini   # Cheap model for contract extraction
AI_ANALYSIS_MODEL=openrouter/gpt-4o           # Better model for detailed analysis

# Pipeline
CACHE_ENABLED=true
CACHE_TTL_SECONDS=604800
RATE_LIMIT_RPS=550
FETCH_PARALLEL=500
TEST_LIMIT=500

# Paths
INPUT_DIR=./data/input/DeFiHackLabs/src/test
OUTPUT_DIR=./data/output
CACHE_DIR=./data/cache
CHUNK_SIZE=100
